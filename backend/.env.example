# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/messagent

# ─── Redis (BullMQ + rate limiting) ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production

# ─── Anthropic (Claude — pro/business tier) ───────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Gmail OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials at: console.cloud.google.com → APIs & Services → Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Server-side redirect URI (registered in Google Cloud Console)
GMAIL_REDIRECT_URI=http://localhost:4000/gmail/callback

# ─── Gmail Pub/Sub (push notifications) ──────────────────────────────────────
# Format: projects/<project-id>/topics/<topic-name>
# The topic must grant "Publish" to gmail-api-push@system.gserviceaccount.com
GMAIL_PUBSUB_TOPIC=projects/my-project/topics/gmail-notifications
# Shared secret sent as X-Goog-Channel-Token header to verify webhook origin
GMAIL_PUBSUB_VERIFY_TOKEN=change_me_to_a_random_secret

# ─── Google Cloud ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT_ID=my-project

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# System user access token from Meta Developer Portal → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
# Phone number ID shown in Meta Developer Portal → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Random secret you set in Meta Developer Portal → WhatsApp → Webhooks → Verify Token
WHATSAPP_VERIFY_TOKEN=
# Graph API version — update when Meta releases a newer stable version
WHATSAPP_API_VERSION=v18.0
# Messagent user UUID that owns this WhatsApp Business Account (single-account mode)
WHATSAPP_OWNER_USER_ID=

# ─── Instagram (Meta Graph API) ───────────────────────────────────────────────
# Create an app at: developers.facebook.com → My Apps → Create App
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Random secret you set in Meta Developer Portal → Webhooks → Verify Token
INSTAGRAM_VERIFY_TOKEN=change_me_to_a_random_secret
# Mobile deep-link redirect URI registered in your Meta app's Valid OAuth Redirect URIs
INSTAGRAM_REDIRECT_URI=messagent://instagram/callback
# Graph API version
INSTAGRAM_API_VERSION=v18.0

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get keys from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=
# Get from: dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Create prices at: dashboard.stripe.com → Products → Add Product
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_BUSINESS_PRICE_ID=price_yyy
# Where to redirect after successful checkout (mobile deep link)
FRONTEND_URL=messagent://

# ─── On-device Gemma model (free tier) ───────────────────────────────────────
# Bump MODEL_VERSION whenever a new model file is published — mobile clients compare
# this against their locally stored version string and prompt a download if different.
MODEL_VERSION=gemma-2b-it-q4-v1.0
# Direct download URL for the model weights (.bin / .gguf file)
MODEL_URL=
# Approximate model file size in megabytes (shown in the update banner)
MODEL_SIZE_MB=1400
# Minimum app version required to run this model
MODEL_MIN_APP_VERSION=1.0.0
