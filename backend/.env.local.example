# ─────────────────────────────────────────────────────────────────────────────
# Messagent — LOCAL DEVELOPMENT environment variables
# ─────────────────────────────────────────────────────────────────────────────
# This file contains ONLY the variables needed to run the app locally.
# Copy it to .env before starting:
#
#   cp .env.local.example .env
#
# Full variable reference (all platforms + prod): see .env.example
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# CORS: comma-separated list of allowed origins (Expo web dev server + any browser testing)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Matches the credentials set in docker-compose.yml.
# If you are running Postgres outside Docker, adjust host/user/pass accordingly.
DATABASE_URL=postgresql://messagent:messagent_dev@localhost:5432/messagent

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local Redis has no password — leave REDIS_PASSWORD blank.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Any random string works locally — just keep it consistent between restarts
# so existing JWTs don't break. In production use a 32+ byte random value.
JWT_SECRET=local_dev_secret_change_me_for_production

# ─── Anthropic (Claude — Pro/Business tier AI replies) ────────────────────────
# REQUIRED for Pro/Business AI replies. Free-tier uses on-device Gemma instead,
# so you CAN skip this initially — the server will start fine without it.
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# The variables below can be left blank for initial local setup.
# The server starts without them; only the specific platform flow will fail.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Gmail OAuth (needed to test Gmail connect + webhook flow) ────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/gmail/callback
GMAIL_PUBSUB_TOPIC=projects/my-project/topics/gmail-notifications
GMAIL_PUBSUB_VERIFY_TOKEN=local_gmail_token
GOOGLE_CLOUD_PROJECT_ID=my-project

# ─── WhatsApp (skip for local dev unless testing WhatsApp webhooks) ───────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=local_whatsapp_token
WHATSAPP_API_VERSION=v18.0
WHATSAPP_OWNER_USER_ID=

# ─── Instagram (skip for local dev unless testing Instagram webhooks) ─────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=local_instagram_token
INSTAGRAM_REDIRECT_URI=messagent://instagram/callback
INSTAGRAM_API_VERSION=v18.0

# ─── Stripe (skip for local dev unless testing subscriptions) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_BUSINESS_PRICE_ID=price_yyy
FRONTEND_URL=messagent://

# ─── Gemma on-device model (served to mobile clients) ────────────────────────
MODEL_VERSION=gemma-2b-it-q4-v1.0
MODEL_URL=
MODEL_SIZE_MB=1400
MODEL_MIN_APP_VERSION=1.0.0
